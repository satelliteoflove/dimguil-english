{
    "file": "DATA06/NPC_MES5.OBJ",
    "extendByBytes": 58609,
    "sections": [
        {
            "firstHeaderAddress": 0,
            "firstHeader": 496,
            "sectionLength": 6183,
            "compress": true,
            "strings": [
                {
                    "length": 27,
                    "source": "NA",
                    "translation": "Big Dracon\n\"Don't know your faces...",
                    "addStringTerminator": true
                },
                {
                    "length": 31,
                    "source": "NA",
                    "translation": "Big Dracon\n\"...Haven't seen your party around.",
                    "addStringTerminator": true
                },
                {
                    "length": 30,
                    "source": "NA",
                    "translation": "Zaril\n\"Yo! Long time no see. How've you been?",
                    "addStringTerminator": true
                },
                {
                    "length": 18,
                    "source": "NA",
                    "translation": "Shaggy man\n\"Mmm?",
                    "addStringTerminator": true
                },
                {
                    "length": 45,
                    "source": "NA",
                    "translation": "Short man\n\"Hey, I've heard all about you guys.\n Ain't you ever heard of me?",
                    "addStringTerminator": true
                },
                {
                    "length": 19,
                    "source": "NA",
                    "translation": "Big Dracon\n\"See ya.",
                    "addStringTerminator": true
                },
                {
                    "length": 21,
                    "source": "NA",
                    "translation": "Shaggy man\n\"Mmm...",
                    "addStringTerminator": true
                },
                {
                    "length": 18,
                    "source": "NA",
                    "translation": "Short man\n\"Hmph!",
                    "addStringTerminator": true
                },
                {
                    "length": 63,
                    "source": "NA",
                    "translation": "Zaril\n\"That {ff12} of yours...\n\r Hope the Kadorto takes.\n See ya. You lot watch yourselves too.",
                    "addStringTerminator": true
                },
                {
                    "length": 28,
                    "source": "NA",
                    "translation": "Zaril\n\"See ya. You lot watch yourselves too.",
                    "addStringTerminator": true
                },
                {
                    "length": 15,
                    "source": "NA",
                    "translation": "Gaura\n\"Bye-bye.",
                    "addStringTerminator": true
                },
                {
                    "length": 45,
                    "source": "NA",
                    "translation": "Gaura\n\"{ff12}... w-wasn't moving.\n N-next time, m-maybe we t-talk...",
                    "addStringTerminator": true
                },
                {
                    "length": 31,
                    "source": "NA",
                    "translation": "Fritillaria\n\"See ya! Take care, everybody!",
                    "addStringTerminator": true
                },
                {
                    "length": 37,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Tch, it's you guys...\n Whaddaya want with me?",
                    "addStringTerminator": true
                },
                {
                    "length": 36,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Oh, it's just you guys!\n Whaddaya want with me?",
                    "addStringTerminator": true
                },
                {
                    "length": 56,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Hey! You doin' good?\n Me, I'm doin' great, as ya can see.\n\r So whaddaya need today?",
                    "addStringTerminator": true
                },
                {
                    "length": 34,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Hey! It's the murder squad.\n You guys kill way too much!",
                    "addStringTerminator": true
                },
                {
                    "length": 47,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Hey! It's {ff12}, the walkin' corpse!\n Nice to catch ya alive this time.",
                    "addStringTerminator": true
                },
                {
                    "length": 23,
                    "source": "NA",
                    "translation": "Gaura\n\"Ohh, oh... G-good morning.",
                    "addStringTerminator": true
                },
                {
                    "length": 20,
                    "source": "NA",
                    "translation": "Gaura\n\"Heyyy. H-hello.",
                    "addStringTerminator": true
                },
                {
                    "length": 35,
                    "source": "NA",
                    "translation": "Zaril\n\"Hey! How's the exploring?\n Going all right?",
                    "addStringTerminator": true
                },
                {
                    "length": 11,
                    "source": "NA",
                    "translation": "Zaril\n\"Yo.",
                    "addStringTerminator": true
                },
                {
                    "length": 21,
                    "source": "NA",
                    "translation": "Zaril\n\"You lot again...",
                    "addStringTerminator": true
                },
                {
                    "length": 79,
                    "source": "NA",
                    "translation": "Zaril\n\"What splendid equipment you have.\n Might you be willing to part with it?\n\r Every piece of it is so very fitting\n for someone like me.",
                    "addStringTerminator": true
                },
                {
                    "length": 105,
                    "source": "NA",
                    "translation": "Zaril\n\"How many heads must you lop off\n before you are satisfied?\n\r One cruel killing machine I could\n understand, but all of you?\n\r I do wish you would learn a little\n more about the sanctity of life.",
                    "addStringTerminator": true
                },
                {
                    "length": 15,
                    "source": "NA",
                    "translation": "Zaril\n\"Hey there, comrade.",
                    "addStringTerminator": true
                },
                {
                    "length": 21,
                    "source": "NA",
                    "translation": "Big Dracon\n\"Nice to meet you.",
                    "addStringTerminator": true
                },
                {
                    "length": 107,
                    "source": "NA",
                    "translation": "Zaril\n\"I am Zaril, leader of this party.\n\r Well, I say party, but there's only\n two others. Still, let me introduce 'em.\n This little one's Fritillaria.",
                    "addStringTerminator": true
                },
                {
                    "length": 126,
                    "source": "NA",
                    "translation": "Zaril\n\"Truth is, starting now I'm gonna be\n the leader of this party.\n\r Well, I say party, but there's only\n two others. Still, let me introduce 'em.\n This little one's Fritillaria.",
                    "addStringTerminator": true
                },
                {
                    "length": 26,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Ya didn't have to say \"little\"!",
                    "addStringTerminator": true
                },
                {
                    "length": 37,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Hiya! Fritillaria the Thief, that's me!\n Nice to meetcha!",
                    "addStringTerminator": true
                },
                {
                    "length": 32,
                    "source": "NA",
                    "translation": "Zaril\n\"And this shaggy one here is...",
                    "addStringTerminator": true
                },
                {
                    "length": 11,
                    "source": "NA",
                    "translation": "Gaura\n\"Yo!",
                    "addStringTerminator": true
                },
                {
                    "length": 38,
                    "source": "NA",
                    "translation": "Zaril\n\"So, that's about the size of it.\n Hope we get along from here on out.",
                    "addStringTerminator": true
                },
                {
                    "length": 23,
                    "source": "NA",
                    "translation": "Zaril\n\"Friendly-like, if we can manage it.",
                    "addStringTerminator": true
                },
                {
                    "length": 56,
                    "source": "NA",
                    "translation": "Zaril\n\"Can't be helped. Curing? Healing?\n So who's the one needs my help?",
                    "addStringTerminator": true
                },
                {
                    "length": 30,
                    "source": "NA",
                    "translation": "Zaril\n\"Look... quit wasting my time, would ya?",
                    "addStringTerminator": true
                },
                {
                    "length": 35,
                    "source": "NA",
                    "translation": "Zaril\n\"This here... Sorry, can't cure this one.",
                    "addStringTerminator": true
                },
                {
                    "length": 40,
                    "source": "NA",
                    "translation": "Zaril\n\"Fine, fine.\n         {ff30}2Dialko{ff30}0",
                    "addStringTerminator": true
                },
                {
                    "length": 39,
                    "source": "NA",
                    "translation": "Zaril\n\"Fine, fine.\n        {ff30}2Latumofis{ff30}0",
                    "addStringTerminator": true
                },
                {
                    "length": 49,
                    "source": "NA",
                    "translation": "Zaril\n\"Ah, sorry. I've used up all my healing\n spells. Got none left.",
                    "addStringTerminator": true
                },
                {
                    "length": 53,
                    "source": "NA",
                    "translation": "Zaril\n\"Fine, fine.\n        {ff30}2Dialma{ff30}0\n\r There, how's that!",
                    "addStringTerminator": true
                },
                {
                    "length": 43,
                    "source": "NA",
                    "translation": "Zaril\n\"That so? Well, from here on, keep\n the trip home in mind.",
                    "addStringTerminator": true
                },
                {
                    "length": 210,
                    "source": "NA",
                    "translation": "Zaril\n\"You folks look healthy enough.\n Is your gear holding up?\n\r The deeper we go, the more I feel\n how much good gear matters.\n\r We got some items out of a chest back\n there, but they're still unidentified.\n No Bishop in our party, see.\n\r So how about it? Interested in buying\n one of the three items we found?",
                    "addStringTerminator": true
                },
                {
                    "length": 9,
                    "source": "NA",
                    "translation": "Buy one?",
                    "addStringTerminator": true
                },
                {
                    "length": 55,
                    "source": "NA",
                    "translation": "Zaril\n\"Then pick from the three below.\n Any of 'em's yours for {ff11}0Gp.",
                    "addStringTerminator": true
                },
                {
                    "length": 29,
                    "source": "NA",
                    "translation": "A:Weapons\nB:Armor\nC:Other\nD:Quit",
                    "addStringTerminator": true
                },
                {
                    "length": 9,
                    "source": "NA",
                    "translation": "Which one?",
                    "addStringTerminator": true
                },
                {
                    "length": 37,
                    "source": "NA",
                    "translation": "Zaril\n\"Hey, you're short on cash.\n Some other time.",
                    "addStringTerminator": true
                },
                {
                    "length": 21,
                    "source": "NA",
                    "translation": "Zaril\n\"Got it. Some other time, then.",
                    "addStringTerminator": true
                },
                {
                    "length": 16,
                    "source": "NA",
                    "translation": "{ff12} obtained an item.",
                    "addStringTerminator": true
                },
                {
                    "length": 129,
                    "source": "NA",
                    "translation": "Zaril\n\"Sorry, I'm not in the mood right now.\n What, you calling me chicken?\n\r What're you after, getting me this mad?\n Fine, if you're gonna push it that far,\n I'll fight you.\n\r Next time we meet, don't you ever\n mouth off like that again.",
                    "addStringTerminator": true
                },
                {
                    "length": 12,
                    "source": "NA",
                    "translation": "Fight anyway?",
                    "addStringTerminator": true
                },
                {
                    "length": 45,
                    "source": "NA",
                    "translation": "Zaril\n\"So you're the chicken, then.\n We're busy. We'll be moving on.",
                    "addStringTerminator": true
                },
                {
                    "length": 37,
                    "source": "NA",
                    "translation": "Zaril\n\"Don't know a thing either.\n I said I don't know, so I don't know.",
                    "addStringTerminator": true
                },
                {
                    "length": 20,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Don't ask me!",
                    "addStringTerminator": true
                },
                {
                    "length": 24,
                    "source": "NA",
                    "translation": "Gaura\n\"Zzz... Zzz.........",
                    "addStringTerminator": true
                },
                {
                    "length": 33,
                    "source": "NA",
                    "translation": "Zaril\n\".........\n And? So what?",
                    "addStringTerminator": true
                },
                {
                    "length": 33,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Whaaat? You got business with me or somethin'?",
                    "addStringTerminator": true
                },
                {
                    "length": 14,
                    "source": "NA",
                    "translation": "Gaura\n\"Mmm...",
                    "addStringTerminator": true
                },
                {
                    "length": 33,
                    "source": "NA",
                    "translation": "Zaril\n\".........\n And? So what?",
                    "addStringTerminator": true
                },
                {
                    "length": 46,
                    "source": "NA",
                    "translation": "Fritillaria\n\"............\n Hmph! So what?",
                    "addStringTerminator": true
                },
                {
                    "length": 17,
                    "source": "NA",
                    "translation": "Gaura\n\"Hm hm hmm, hm hm hmmm.",
                    "addStringTerminator": true
                },
                {
                    "length": 47,
                    "source": "NA",
                    "translation": "Zaril\n\"So there really are Evil Lords out there.\n First one I've ever met.",
                    "addStringTerminator": true
                },
                {
                    "length": 54,
                    "source": "NA",
                    "translation": "Fritillaria\n\"I met this guy called Balbo, but\n I don't think I'm gonna like him much.",
                    "addStringTerminator": true
                },
                {
                    "length": 42,
                    "source": "NA",
                    "translation": "Fritillaria\n\"'Cause he keeps callin' me a brat!",
                    "addStringTerminator": true
                },
                {
                    "length": 29,
                    "source": "NA",
                    "translation": "Gaura\n\"Balbo, scary. Ran away.",
                    "addStringTerminator": true
                },
                {
                    "length": 24,
                    "source": "NA",
                    "translation": "Zaril\n\"Saw some scholars in the archives.",
                    "addStringTerminator": true
                },
                {
                    "length": 34,
                    "source": "NA",
                    "translation": "Fritillaria\n\"That elf guy in the archives is real nice, huh?",
                    "addStringTerminator": true
                },
                {
                    "length": 29,
                    "source": "NA",
                    "translation": "Gaura\n\"There, lots of books. Studying.",
                    "addStringTerminator": true
                },
                {
                    "length": 39,
                    "source": "NA",
                    "translation": "Zaril\n\"Ran into somebody wrapped in garb\n like nothing I've ever seen.",
                    "addStringTerminator": true
                },
                {
                    "length": 45,
                    "source": "NA",
                    "translation": "Zaril\n\"Might be we've gone and stuck our\n necks into something nasty.",
                    "addStringTerminator": true
                },
                {
                    "length": 159,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Way before I teamed up with Zaril,\n I met this weird guy.\n\r He looked like a Fighter or a Lord, sorta,\n but he was in a big hurry, and I ain't\n heard of nobody else meetin' him.\n\r Maybe he ain't from this world?",
                    "addStringTerminator": true
                },
                {
                    "length": 26,
                    "source": "NA",
                    "translation": "Gaura\n\"Scary man. Was grumbling.",
                    "addStringTerminator": true
                },
                {
                    "length": 28,
                    "source": "NA",
                    "translation": "Zaril\n\"Info? ......Nope. Got nothing.",
                    "addStringTerminator": true
                },
                {
                    "length": 31,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Sorry, I don't know nothin'.",
                    "addStringTerminator": true
                },
                {
                    "length": 29,
                    "source": "NA",
                    "translation": "Gaura\n\"That way............... maybe?",
                    "addStringTerminator": true
                },
                {
                    "length": 62,
                    "source": "NA",
                    "translation": "Zaril\n\"Me? Nothing I'm especially good or bad at.\n Sword or magic, I can handle it all.",
                    "addStringTerminator": true
                },
                {
                    "length": 31,
                    "source": "NA",
                    "translation": "Fritillaria\n\"When I grow up, I wanna be a Ninja.",
                    "addStringTerminator": true
                },
                {
                    "length": 31,
                    "source": "NA",
                    "translation": "Gaura\n\"M-me, not picky.\n Good guy.",
                    "addStringTerminator": true
                },
                {
                    "length": 64,
                    "source": "NA",
                    "translation": "Zaril\n\"......\n\r Well, same goes for us, but I guess\n you lot are still greenhorns too, huh.",
                    "addStringTerminator": true
                },
                {
                    "length": 64,
                    "source": "NA",
                    "translation": "Fritillaria\n\"...............\n\r Whoa... you guys are way tougher\n than you look.",
                    "addStringTerminator": true
                },
                {
                    "length": 41,
                    "source": "NA",
                    "translation": "Gaura\n\"M-me, s-slow.\n B-but, everything else, great.",
                    "addStringTerminator": true
                },
                {
                    "length": 27,
                    "source": "NA",
                    "translation": "Zaril\n\"Sorry. Nothing new to tell.",
                    "addStringTerminator": true
                },
                {
                    "length": 112,
                    "source": "NA",
                    "translation": "Fritillaria\n\"I got paralyzed, couldn't move a muscle,\n\r and they ditched me all by myself.\n Zaril's the one who saved me.\n\r That's how come I stick with Zaril.",
                    "addStringTerminator": true
                },
                {
                    "length": 36,
                    "source": "NA",
                    "translation": "Gaura\n\"Me, know nothing.\n Mmm...... Sorry.",
                    "addStringTerminator": true
                },
                {
                    "length": 70,
                    "source": "NA",
                    "translation": "Zaril\n\"You met that dwarf, Balbo?\n\r Lately I've started thinking\n a guy like that's all right.",
                    "addStringTerminator": true
                },
                {
                    "length": 38,
                    "source": "NA",
                    "translation": "Fritillaria\n\"I got nothin' new to spill.\n Sorry!",
                    "addStringTerminator": true
                },
                {
                    "length": 28,
                    "source": "NA",
                    "translation": "Gaura\n\"M-me, g-gonna be Samurai. Someday.",
                    "addStringTerminator": true
                },
                {
                    "length": 68,
                    "source": "NA",
                    "translation": "Zaril\n\"I wanna be like that Balbo, so\n\r I've been picking fights with every\n monster I come across, but...",
                    "addStringTerminator": true
                },
                {
                    "length": 87,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Lately it looks like Zaril's trying to\n change his alignment..........\n\r I like Zaril just the way he is.",
                    "addStringTerminator": true
                },
                {
                    "length": 28,
                    "source": "NA",
                    "translation": "Gaura\n\"M-me, g-gonna be Samurai. Someday.",
                    "addStringTerminator": true
                },
                {
                    "length": 40,
                    "source": "NA",
                    "translation": "Zaril\n\"Huh? Why should I have to tell\n you that?",
                    "addStringTerminator": true
                },
                {
                    "length": 40,
                    "source": "NA",
                    "translation": "Fritillaria\n\"............!\n Whoa, awesome! You guys are somethin'!",
                    "addStringTerminator": true
                },
                {
                    "length": 40,
                    "source": "NA",
                    "translation": "Gaura\n\"M-me, when Samurai,\n g-gonna get Muramasa.",
                    "addStringTerminator": true
                },
                {
                    "length": 27,
                    "source": "NA",
                    "translation": "Zaril\n\"Sorry. Nothing new to tell.",
                    "addStringTerminator": true
                },
                {
                    "length": 31,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Aw, that again.........",
                    "addStringTerminator": true
                },
                {
                    "length": 18,
                    "source": "NA",
                    "translation": "Gaura\n\"Th-that, heard it.",
                    "addStringTerminator": true
                },
                {
                    "length": 28,
                    "source": "NA",
                    "translation": "We asked if they had any news.",
                    "addStringTerminator": true
                },
                {
                    "length": 25,
                    "source": "NA",
                    "translation": "We told them everything we knew.",
                    "addStringTerminator": true
                },
                {
                    "length": 21,
                    "source": "NA",
                    "translation": "We asked them about themselves.",
                    "addStringTerminator": true
                },
                {
                    "length": 22,
                    "source": "NA",
                    "translation": "We asked about other parties.",
                    "addStringTerminator": true
                },
                {
                    "length": 20,
                    "source": "NA",
                    "translation": "We asked them something personal.",
                    "addStringTerminator": true
                },
                {
                    "length": 92,
                    "source": "NA",
                    "translation": "  From within the black shadow before you,\n  something darker still than the shadow\n  came seeping out without a sound.",
                    "addStringTerminator": true
                },
                {
                    "length": 96,
                    "source": "NA",
                    "translation": "  The shadow, heavy with a killing intent\n  that clung to your very skin, cried out\n  in a man's voice.\n\r  Then, as silently as it had appeared,\n  it melted back into the shadow.",
                    "addStringTerminator": true
                },
                {
                    "length": 179,
                    "source": "NA",
                    "translation": "Mysterious figure\n\"Begone, unbelievers in the old god!\n Hear my words and heed my warning!\n\r Beyond lies the holy ground of the\n Opener of the Door! Any other who goes\n further shall know the wrath of our god!\n\r \n         Begone!",
                    "addStringTerminator": true
                },
                {
                    "length": 75,
                    "source": "NA",
                    "translation": "Mysterious man\n\"Fools! You have scorned my warning!\n\r Now you shall bear the punishment for\n the sin you yourselves have wrought!",
                    "addStringTerminator": true
                },
                {
                    "length": 151,
                    "source": "NA",
                    "translation": "Mysterious man\n\"Adventurers who have come this far,\n beyond this point lies the real world.\n\r If it is dreams you seek, you would\n do well to go no further.\n\r You are not yet ready, are you?\n Calm yourselves and consider once more\n what manner of place you stand upon.",
                    "addStringTerminator": true
                },
                {
                    "length": 232,
                    "source": "NA",
                    "translation": "Mysterious man\n\"So you have reached this place at last.\n You look puzzled.\n\r No doubt it is hard for lesser beings\n such as you to grasp who I am.\n\r But I would hope you can at least see\n that this place is not of your world.\n\r I would have you understand this great\n iron ship. Our long-held dream is not\n merely to rebuild it.",
                    "addStringTerminator": true
                },
                {
                    "length": 233,
                    "source": "NA",
                    "translation": " We journeyed from far, far away\n to find an eternal paradise.\n\r Were it not for a fatal accident, we\n could have remade this planet into\n a paradise.\n\r I alone survived. To ease my solitude,\n I spent long years in research,\n repeating experiment after experiment.\n\r But they crumbled once out of the tanks,\n or hatched from eggs and never grew,\n never showing any intelligence...",
                    "addStringTerminator": true
                },
                {
                    "length": 180,
                    "source": "NA",
                    "translation": " It was amid those repeated failures\n that I came upon you lesser beings.\n\r Fuel leaking from this ship threw this\n planet's ecosystem into disorder. You,\n who arose from it, were wholly unforeseen.\n\r I could no longer see the future. This\n world is too full of the unexpected\n for me to bear.",
                    "addStringTerminator": true
                },
                {
                    "length": 233,
                    "source": "NA",
                    "translation": " If the lesser beings we created should\n surpass us, then so be it.\n\r As a last resort, we would cross our\n father with one of the few creatures\n in this world fit for the purpose,\n\r and so create an eternal future.\n And now it is complete.\n\r Go on, if you wish to go on.\n Face my father, who is also myself,\n you who know no fear.",
                    "addStringTerminator": true
                },
                {
                    "length": 242,
                    "source": "NA",
                    "translation": "Mysterious man\n\"I am Agan, the eternal traveler.\n Demons bore me away into a world long past.\n\r Beneath this ground, it seems, lies a\n place where monsters stir that even\n the gods cannot control.\n\r But it is sealed fast, and\n cannot be opened.\n\r I must go there and gain more power\n so that I may return to my homeland.\n I must hurry on. Farewell.",
                    "addStringTerminator": true
                },
                {
                    "length": 30,
                    "source": "NA",
                    "translation": "Zaril\n\"Yo! Long time no see. How've you been?",
                    "addStringTerminator": true
                },
                {
                    "length": 17,
                    "source": "NA",
                    "translation": "We asked them for healing.",
                    "addStringTerminator": true
                },
                {
                    "length": 22,
                    "source": "NA",
                    "translation": "We asked them to identify items.",
                    "addStringTerminator": true
                },
                {
                    "length": 22,
                    "source": "NA",
                    "translation": "We asked them to rescue our comrades.",
                    "addStringTerminator": true
                },
                {
                    "length": 17,
                    "source": "NA",
                    "translation": "We asked them who they were.",
                    "addStringTerminator": true
                },
                {
                    "length": 21,
                    "source": "NA",
                    "translation": "Gaura\n\"Ughh.........",
                    "addStringTerminator": true
                },
                {
                    "length": 13,
