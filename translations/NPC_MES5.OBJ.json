{
    "file": "DATA06/NPC_MES5.OBJ",
    "extendByBytes": 58609,
    "sections": [
        {
            "firstHeaderAddress": 0,
            "firstHeader": 496,
            "sectionLength": 6183,
            "compress": true,
            "strings": [
                {
                    "length": 27,
                    "source": "NA",
                    "translation": "Big Dracon\n\"Don't know your faces...",
                    "addStringTerminator": true
                },
                {
                    "length": 31,
                    "source": "NA",
                    "translation": "Big Dracon\n\"...Haven't seen your party around.",
                    "addStringTerminator": true
                },
                {
                    "length": 30,
                    "source": "NA",
                    "translation": "Zaril\n\"Yo! Long time no see. How've you been?",
                    "addStringTerminator": true
                },
                {
                    "length": 18,
                    "source": "NA",
                    "translation": "Hairy man\n\"Mm?",
                    "addStringTerminator": true
                },
                {
                    "length": 45,
                    "source": "NA",
                    "translation": "Short guy\n\"Hey, I've heard all about you guys.\n You mean you've never heard of me?",
                    "addStringTerminator": true
                },
                {
                    "length": 19,
                    "source": "NA",
                    "translation": "Big Dracon\n\"See you.",
                    "addStringTerminator": true
                },
                {
                    "length": 21,
                    "source": "NA",
                    "translation": "Hairy man\n\"Mmm...",
                    "addStringTerminator": true
                },
                {
                    "length": 18,
                    "source": "NA",
                    "translation": "Short guy\n\"Hmph!",
                    "addStringTerminator": true
                },
                {
                    "length": 63,
                    "source": "NA",
                    "translation": "Zaril\n\"That {ff12}...\n Hope the Kadorto works out.\n\r See you. You lot take care too.",
                    "addStringTerminator": true
                },
                {
                    "length": 28,
                    "source": "NA",
                    "translation": "Zaril\n\"See you. You lot take care too.",
                    "addStringTerminator": true
                },
                {
                    "length": 15,
                    "source": "NA",
                    "translation": "Gaura\n\"Bye-bye.",
                    "addStringTerminator": true
                },
                {
                    "length": 45,
                    "source": "NA",
                    "translation": "Gaura\n\"{ff12}, w-wasn't moving.\n Next time, m-maybe we talk...",
                    "addStringTerminator": true
                },
                {
                    "length": 31,
                    "source": "NA",
                    "translation": "Fritillaria\n\"See ya! Take care, everybody!",
                    "addStringTerminator": true
                },
                {
                    "length": 37,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Tch, it's you guys...\n Whaddya want with me?",
                    "addStringTerminator": true
                },
                {
                    "length": 36,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Oh, it's just you guys!\n Need somethin' from me?",
                    "addStringTerminator": true
                },
                {
                    "length": 56,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Hey! You doin' good?\n I'm doin' great, as you can see.\n\r So what's up today?",
                    "addStringTerminator": true
                },
                {
                    "length": 34,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Hey! It's the murder squad.\n You guys kill way too much!",
                    "addStringTerminator": true
                },
                {
                    "length": 47,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Hey! It's {ff12}, the walking corpse!\n This time we met while you're alive.",
                    "addStringTerminator": true
                },
                {
                    "length": 23,
                    "source": "NA",
                    "translation": "Gaura\n\"Ohh... Mo... G-good morning.",
                    "addStringTerminator": true
                },
                {
                    "length": 20,
                    "source": "NA",
                    "translation": "Gaura\n\"Heyyy. H-hello.",
                    "addStringTerminator": true
                },
                {
                    "length": 35,
                    "source": "NA",
                    "translation": "Zaril\n\"Hey! How's the exploring coming along?\n Going all right?",
                    "addStringTerminator": true
                },
                {
                    "length": 11,
                    "source": "NA",
                    "translation": "Zaril\n\"Hey.",
                    "addStringTerminator": true
                },
                {
                    "length": 21,
                    "source": "NA",
                    "translation": "Zaril\n\"You lot again...",
                    "addStringTerminator": true
                },
                {
                    "length": 79,
                    "source": "NA",
                    "translation": "Zaril\n\"What splendid equipment you have.\n Might you be willing to part with it?\n\r Every piece of it is so very fitting\n for someone like me.",
                    "addStringTerminator": true
                },
                {
                    "length": 105,
                    "source": "NA",
                    "translation": "Zaril\n\"How many heads must you lop off\n before you are satisfied?\n\r One cruel killing machine I could\n understand, but all of you?\n\r I do wish you would learn a little\n more about the sanctity of life.",
                    "addStringTerminator": true
                },
                {
                    "length": 15,
                    "source": "NA",
                    "translation": "Zaril\n\"Hey there, comrade.",
                    "addStringTerminator": true
                },
                {
                    "length": 21,
                    "source": "NA",
                    "translation": "Big Dracon\n\"Nice to meet you.",
                    "addStringTerminator": true
                },
                {
                    "length": 107,
                    "source": "NA",
                    "translation": "Zaril\n\"I'm Zaril, leader of this party.\n\r Well, I say party, but there's only\n two others. Still, let me introduce 'em.\n This little one's Fritillaria.",
                    "addStringTerminator": true
                },
                {
                    "length": 126,
                    "source": "NA",
                    "translation": "Zaril\n\"Truth is, starting now I'm gonna be\n the leader of this party.\n\r Well, I say party, but there's only\n two others. Still, let me introduce 'em.\n This little one's Fritillaria.",
                    "addStringTerminator": true
                },
                {
                    "length": 26,
                    "source": "NA",
                    "translation": "Fritillaria\n\"You didn't need the \"little\" part!",
                    "addStringTerminator": true
                },
                {
                    "length": 37,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Hi! I'm Fritillaria the Thief!\n Nice to meetcha!",
                    "addStringTerminator": true
                },
                {
                    "length": 32,
                    "source": "NA",
                    "translation": "Zaril\n\"And this hairy one here is...",
                    "addStringTerminator": true
                },
                {
                    "length": 11,
                    "source": "NA",
                    "translation": "Gaura\n\"Yo!",
                    "addStringTerminator": true
                },
                {
                    "length": 38,
                    "source": "NA",
                    "translation": "Zaril\n\"So yeah, that's about it.\n Hope we get along from here on.",
                    "addStringTerminator": true
                },
                {
                    "length": 23,
                    "source": "NA",
                    "translation": "Zaril\n\"Friendly-like, if we can manage it.",
                    "addStringTerminator": true
                },
                {
                    "length": 56,
                    "source": "NA",
                    "translation": "Zaril\n\"Fine, fine. Need curing? Healing?\n So who's the one needs my help?",
                    "addStringTerminator": true
                },
                {
                    "length": 30,
                    "source": "NA",
                    "translation": "Zaril\n\"Look... quit messing me around, would ya?",
                    "addStringTerminator": true
                },
                {
                    "length": 35,
                    "source": "NA",
                    "translation": "Zaril\n\"This is... sorry, I can't cure this one.",
                    "addStringTerminator": true
                },
                {
                    "length": 40,
                    "source": "NA",
                    "translation": "Zaril\n\"Fine, fine.\n         {ff30}2Dialko{ff30}0",
                    "addStringTerminator": true
                },
                {
                    "length": 39,
                    "source": "NA",
                    "translation": "Zaril\n\"Fine, fine.\n        {ff30}2Latumofis{ff30}0",
                    "addStringTerminator": true
                },
                {
                    "length": 49,
                    "source": "NA",
                    "translation": "Zaril\n\"Ah, sorry. I've used up all my healing\n spells. Got none left.",
                    "addStringTerminator": true
                },
                {
                    "length": 53,
                    "source": "NA",
                    "translation": "Zaril\n\"Fine, fine.\n        {ff30}2Dialma{ff30}0\n\r There, how's that!",
                    "addStringTerminator": true
                },
                {
                    "length": 43,
                    "source": "NA",
                    "translation": "Zaril\n\"That so? Well, keep the trip home\n in mind in whatever you do.",
                    "addStringTerminator": true
                },
                {
                    "length": 210,
                    "source": "NA",
                    "translation": "Zaril\n\"You folks look healthy enough.\n Is your gear holding up?\n\r The deeper we go, the more I feel\n how much good gear matters.\n\r We got some items out of a chest back\n there, but they're still unidentified.\n No Bishop in our party, see.\n\r So how about it? Interested in buying\n one of the three items we found?",
                    "addStringTerminator": true
                },
                {
                    "length": 9,
                    "source": "NA",
                    "translation": "Buy one?",
                    "addStringTerminator": true
                },
                {
                    "length": 55,
                    "source": "NA",
                    "translation": "Zaril\n\"Then pick from the three below.\n Any of 'em's yours for {ff11}0Gp.",
                    "addStringTerminator": true
                },
                {
                    "length": 29,
                    "source": "NA",
                    "translation": "A:Weapons\nB:Armor\nC:Other\nD:Quit",
                    "addStringTerminator": true
                },
                {
                    "length": 9,
                    "source": "NA",
                    "translation": "Which one?",
                    "addStringTerminator": true
                },
                {
                    "length": 37,
                    "source": "NA",
                    "translation": "Zaril\n\"Hey, you don't have enough money.\n Some other time.",
                    "addStringTerminator": true
                },
                {
                    "length": 21,
                    "source": "NA",
                    "translation": "Zaril\n\"Got it. Some other time, then.",
                    "addStringTerminator": true
                },
                {
                    "length": 16,
                    "source": "NA",
                    "translation": "{ff12} obtained an item.",
                    "addStringTerminator": true
                },
                {
                    "length": 129,
                    "source": "NA",
                    "translation": "Zaril\n\"Sorry, I'm not in the mood right now.\n What, you calling me chicken?\n\r What're you after, getting me this mad?\n Fine, if you're gonna push it that far,\n I'll fight you.\n\r Next time we meet, don't you ever\n mouth off like that again.",
                    "addStringTerminator": true
                },
                {
                    "length": 12,
                    "source": "NA",
                    "translation": "Fight anyway?",
                    "addStringTerminator": true
                },
                {
                    "length": 45,
                    "source": "NA",
                    "translation": "Zaril\n\"So you're the chicken, then.\n We're busy. We'll be moving on.",
                    "addStringTerminator": true
                },
                {
                    "length": 37,
                    "source": "NA",
                    "translation": "Zaril\n\"I don't know anything either.\n When I say I don't know, I don't know.",
                    "addStringTerminator": true
                },
                {
                    "length": 20,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Don't ask me!",
                    "addStringTerminator": true
                },
                {
                    "length": 24,
                    "source": "NA",
                    "translation": "Gaura\n\"Zzz... Zzz.........",
                    "addStringTerminator": true
                },
                {
                    "length": 33,
                    "source": "NA",
                    "translation": "Zaril\n\".........\n And? So what?",
                    "addStringTerminator": true
                },
                {
                    "length": 33,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Whaaat? What d'you want with me?",
                    "addStringTerminator": true
                },
                {
                    "length": 14,
                    "source": "NA",
                    "translation": "Gaura\n\"Mmm...",
                    "addStringTerminator": true
                },
                {
                    "length": 33,
                    "source": "NA",
                    "translation": "Zaril\n\".........\n And? So what?",
                    "addStringTerminator": true
                },
                {
                    "length": 46,
                    "source": "NA",
                    "translation": "Fritillaria\n\"............\n Hmph! So what?",
                    "addStringTerminator": true
                },
                {
                    "length": 17,
                    "source": "NA",
                    "translation": "Gaura\n\"Hmm hm hmm hmmm...",
                    "addStringTerminator": true
                },
                {
                    "length": 47,
                    "source": "NA",
                    "translation": "Zaril\n\"So there really are Evil Lords out there.\n First one I've ever met.",
                    "addStringTerminator": true
                },
                {
                    "length": 54,
                    "source": "NA",
                    "translation": "Fritillaria\n\"I met this guy called Balbo, but\n I don't think I'm gonna like him much.",
                    "addStringTerminator": true
                },
                {
                    "length": 42,
                    "source": "NA",
                    "translation": "Fritillaria\n\"'Cause he called me a brat!",
                    "addStringTerminator": true
                },
                {
                    "length": 29,
                    "source": "NA",
                    "translation": "Gaura\n\"Balbo, scary. Ran away.",
                    "addStringTerminator": true
                },
                {
                    "length": 24,
                    "source": "NA",
                    "translation": "Zaril\n\"There was a scholar down in the archives.",
                    "addStringTerminator": true
                },
                {
                    "length": 34,
                    "source": "NA",
                    "translation": "Fritillaria\n\"The elf guy in the archives is real nice.",
                    "addStringTerminator": true
                },
                {
                    "length": 29,
                    "source": "NA",
                    "translation": "Gaura\n\"There, lots of books. He studied.",
                    "addStringTerminator": true
                },
                {
                    "length": 39,
                    "source": "NA",
                    "translation": "Zaril\n\"Ran into someone dressed in clothes\n like nothing I've ever seen.",
                    "addStringTerminator": true
                },
                {
                    "length": 45,
                    "source": "NA",
                    "translation": "Zaril\n\"Maybe we've stuck our necks into\n something nasty here.",
                    "addStringTerminator": true
                },
                {
                    "length": 159,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Way before I teamed up with Zaril,\n I met this weird guy.\n\r He looked like a Fighter or a Lord,\n but he was in a big hurry, and I never\n heard of anybody else meeting him.\n\r Maybe he's not from this world?",
                    "addStringTerminator": true
                },
                {
                    "length": 26,
                    "source": "NA",
                    "translation": "Gaura\n\"Scary man. Was grumbling.",
                    "addStringTerminator": true
                },
                {
                    "length": 28,
                    "source": "NA",
                    "translation": "Zaril\n\"Info? ......Nope, nothing.",
                    "addStringTerminator": true
                },
                {
                    "length": 31,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Sorry, I don't know nothin'.",
                    "addStringTerminator": true
                },
                {
                    "length": 29,
                    "source": "NA",
                    "translation": "Gaura\n\"That way...............maybe?",
                    "addStringTerminator": true
                },
                {
                    "length": 62,
                    "source": "NA",
                    "translation": "Zaril\n\"Me? I'm not especially good or bad at\n anything. Sword, magic, I handle it all.",
                    "addStringTerminator": true
                },
                {
                    "length": 31,
                    "source": "NA",
                    "translation": "Fritillaria\n\"When I grow up, I wanna be a Ninja.",
                    "addStringTerminator": true
                },
                {
                    "length": 31,
                    "source": "NA",
                    "translation": "Gaura\n\"I-I, not picky. Like everything.\n Good guy.",
                    "addStringTerminator": true
                },
                {
                    "length": 64,
                    "source": "NA",
                    "translation": "Zaril\n\"......\n\r Well, same goes for us, but I guess\n you folks are still greenhorns too, huh.",
                    "addStringTerminator": true
                },
                {
                    "length": 64,
                    "source": "NA",
                    "translation": "Fritillaria\n\"...............\n\r Whoa... you guys are way tougher\n than you look.",
                    "addStringTerminator": true
                },
                {
                    "length": 41,
                    "source": "NA",
                    "translation": "Gaura\n\"I-I, s-slow to move.\n B-but, rest is great.",
                    "addStringTerminator": true
                },
                {
                    "length": 27,
                    "source": "NA",
                    "translation": "Zaril\n\"Sorry. Nothing new to tell.",
                    "addStringTerminator": true
                },
                {
                    "length": 112,
                    "source": "NA",
                    "translation": "Fritillaria\n\"I got paralyzed and couldn't move,\n\r and they just left me behind all alone.\n Then Zaril came and saved me.\n\r That's why I've been sticking\n with Zaril ever since.",
                    "addStringTerminator": true
                },
                {
                    "length": 36,
                    "source": "NA",
                    "translation": "Gaura\n\"I, know nothing.\n Mmm...... Sorry.",
                    "addStringTerminator": true
                },
                {
                    "length": 70,
                    "source": "NA",
                    "translation": "Zaril\n\"You met that dwarf, Balbo?\n\r Lately I've kinda started thinking\n a guy like that is pretty cool.",
                    "addStringTerminator": true
                },
                {
                    "length": 38,
                    "source": "NA",
                    "translation": "Fritillaria\n\"I got nothin' new to spill.\n Sorry!",
                    "addStringTerminator": true
                },
                {
                    "length": 28,
                    "source": "NA",
                    "translation": "Gaura\n\"I-I, g-gonna be Samurai. Someday.",
                    "addStringTerminator": true
                },
                {
                    "length": 68,
                    "source": "NA",
                    "translation": "Zaril\n\"I wanna be like that Balbo, so\n\r I've been picking fights with every\n monster I come across, but...",
                    "addStringTerminator": true
                },
                {
                    "length": 87,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Lately it looks like Zaril's trying to\n change his alignment..........\n\r I like Zaril just the way he is.",
                    "addStringTerminator": true
                },
                {
                    "length": 28,
                    "source": "NA",
                    "translation": "Gaura\n\"I-I, g-gonna be Samurai. Someday.",
                    "addStringTerminator": true
                },
                {
                    "length": 40,
                    "source": "NA",
                    "translation": "Zaril\n\"Huh? Why should I have to tell\n you that?",
                    "addStringTerminator": true
                },
                {
                    "length": 40,
                    "source": "NA",
                    "translation": "Fritillaria\n\"............!\n Whoa! Not bad at all!",
                    "addStringTerminator": true
                },
                {
                    "length": 40,
                    "source": "NA",
                    "translation": "Gaura\n\"I-I, when I'm Samurai,\n g-gonna get Muramasa.",
                    "addStringTerminator": true
                },
                {
                    "length": 27,
                    "source": "NA",
                    "translation": "Zaril\n\"Sorry. Nothing new to tell.",
                    "addStringTerminator": true
                },
                {
                    "length": 31,
                    "source": "NA",
                    "translation": "Fritillaria\n\"Aw, that again.........",
                    "addStringTerminator": true
                },
                {
                    "length": 18,
                    "source": "NA",
                    "translation": "Gaura\n\"H-heard that.",
                    "addStringTerminator": true
                },
                {
                    "length": 28,
                    "source": "NA",
                    "translation": "We asked if they had any news.",
                    "addStringTerminator": true
                },
                {
                    "length": 25,
                    "source": "NA",
                    "translation": "We told them everything we knew.",
                    "addStringTerminator": true
                },
                {
                    "length": 21,
                    "source": "NA",
                    "translation": "We asked them about themselves.",
                    "addStringTerminator": true
                },
                {
                    "length": 22,
                    "source": "NA",
                    "translation": "We asked them about other parties.",
                    "addStringTerminator": true
                },
                {
                    "length": 20,
                    "source": "NA",
                    "translation": "We asked them personal questions.",
                    "addStringTerminator": true
                },
                {
                    "length": 92,
                    "source": "NA",
                    "translation": "  From within the black shadow before you,\n  something darker than the shadow itself\n  seeped out without a sound.",
                    "addStringTerminator": true
                },
                {
                    "length": 96,
                    "source": "NA",
                    "translation": "  The shadow, heavy with a killing intent\n  that clung to your very skin, cried out\n  in a man's voice.\n\r  Then, as silently as it had appeared,\n  it melted back into the shadow.",
                    "addStringTerminator": true
                },
                {
                    "length": 179,
                    "source": "NA",
                    "translation": "Mysterious figure\n\"Begone, unbelievers in the old god!\n Hear my words and heed my warning!\n\r Beyond here is the holy ground of the\n Opener of the Door! Should any other\n go further, our god's wrath awaits!\n\r \n         Begone!",
                    "addStringTerminator": true
                },
                {
                    "length": 75,
                    "source": "NA",
                    "translation": "Mysterious man\n\"Fools! You have ignored my warning!\n\r You must now be punished for the sin\n you yourselves have committed!",
                    "addStringTerminator": true
                },
                {
                    "length": 151,
                    "source": "NA",
                    "translation": "Mysterious man\n\"Adventurers who have come this far,\n beyond here lies the real world.\n\r If dreams are what you seek, you would\n do better not to go on.\n\r You are not ready yet, are you?\n Calm yourselves and consider once more\n just where it is you are standing.",
                    "addStringTerminator": true
                },
                {
                    "length": 232,
                    "source": "NA",
                    "translation": "Mysterious man\n\"So you have reached this place at last.\n You look puzzled.\n\r No doubt it is hard for lesser beings\n such as you to grasp who I am.\n\r But I would hope you can at least see\n that this place is not of your world.\n\r I would have you understand this great\n iron ship. Our long-held dream is not\n merely to rebuild it.",
                    "addStringTerminator": true
                },
                {
                    "length": 233,
                    "source": "NA",
                    "translation": " We journeyed from far, far away\n to find an eternal paradise.\n\r Were it not for a fatal accident, we\n could have remade this planet into\n a paradise.\n\r I alone survived. To ease my solitude,\n I spent long years in research,\n repeating experiment after experiment.\n\r But they crumbled once out of the tanks,\n or hatched from eggs and never grew,\n never showing any intelligence...",
                    "addStringTerminator": true
                },
                {
                    "length": 180,
                    "source": "NA",
                    "translation": " It was amid those repeated failures\n that I came upon you lesser beings.\n\r Fuel leaking from this ship threw this\n planet's ecosystem into disorder. You,\n who arose from it, were wholly unforeseen.\n\r I could no longer see the future. This\n world is too full of the unexpected\n for me to bear.",
                    "addStringTerminator": true
                },
                {
                    "length": 233,
                    "source": "NA",
                    "translation": " If the lesser beings we created should\n surpass us, then so be it.\n\r As a last resort, we would cross our\n father with one of the few creatures\n in this world fit for the purpose,\n\r and so create an eternal future.\n And now it is complete.\n\r Go on, if you wish to go on.\n Face my father, who is also myself,\n you who know no fear.",
                    "addStringTerminator": true
                },
                {
                    "length": 242,
                    "source": "NA",
                    "translation": "Mysterious man\n\"I am Agan, the eternal traveler.\n Demons dragged me into the past.\n\r Beneath this ground, it seems, lies a\n place where monsters stir that even\n the gods cannot control.\n\r But it is under a powerful seal and\n cannot be opened.\n\r I must go there and gain more power\n so that I can return to my homeland.\n I must hurry on. Farewell.",
                    "addStringTerminator": true
                },
                {
                    "length": 30,
                    "source": "NA",
                    "translation": "Zaril\n\"Yo! Long time no see. How've you been?",
                    "addStringTerminator": true
                },
                {
                    "length": 17,
                    "source": "NA",
                    "translation": "We asked them to heal us.",
                    "addStringTerminator": true
                },
                {
                    "length": 22,
                    "source": "NA",
                    "translation": "We asked them to identify items.",
                    "addStringTerminator": true
                },
                {
                    "length": 22,
                    "source": "NA",
                    "translation": "We asked them to rescue our comrades.",
                    "addStringTerminator": true
                },
                {
                    "length": 17,
                    "source": "NA",
                    "translation": "We asked them about themselves.",
                    "addStringTerminator": true
                },
                {
                    "length": 21,
                    "source": "NA",
                    "translation": "Gaura\n\"Ughh.........",
                    "addStringTerminator": true
                },
                {
                    "length": 13,
                    "source": "NA",
                    "translation": "Zaril\n\"Whoa!!",
                    "addStringTerminator": true
                },
                {
